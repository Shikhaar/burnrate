BURNRATE_DATABASE_URL=sqlite:///./burnrate.db
# BURNRATE_DATABASE_URL=postgresql+psycopg://burnrate:burnrate@localhost:5432/burnrate
BURNRATE_CORS_ORIGINS=["http://localhost:3000"]
# Optional bearer token for the dashboard API (leave empty for local demo)
BURNRATE_DASHBOARD_TOKEN=
# Admin keys for `burnrate sync`. Burnrate only reads cost/usage reports, but these keys can manage
# your provider account: set them only for the sync job (see docs/deploy.md#keys-and-access).
BURNRATE_OPENAI_ADMIN_KEY=
BURNRATE_ANTHROPIC_ADMIN_KEY=
# AI coding tools: Cursor team admin key; GitHub token (org owner/billing manager) + org for Copilot
BURNRATE_CURSOR_ADMIN_KEY=
BURNRATE_GITHUB_TOKEN=
BURNRATE_GITHUB_ORG=
BURNRATE_ALERT_WEBHOOK_URL=
